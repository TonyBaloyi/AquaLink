NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SECRET_KEY=sb_secret_YOUR_BACKEND_ONLY_KEY

# Data layer (Supabase PostgreSQL)
DATABASE_URL=postgresql://YOUR_SUPABASE_DATABASE_CONNECTION_STRING
DB_SSL=true

# IoT layer - devices authenticate with this key on /readings ingest
DEVICE_API_KEY=aqualink-device-key

# External services
PAYMENT_PROVIDER=payfast
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
NOTIFY_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Background jobs
ENABLE_SCHEDULER=true
LOW_TANK_THRESHOLD=20
NO_FLOW_HOURS=6

CORS_ORIGIN=http://localhost:3000,https://aqualink-khaki.vercel.app
PASSWORD_RESET_REDIRECT_URL=https://aqualink-khaki.vercel.app/reset-password
